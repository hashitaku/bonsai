{
  "$schema": "https://opencode.ai/config.json",
  "theme": "tokyonight",
  "keybinds": {
    "input_newline": "shift+return",
  },
  "permission": {
    "*": "ask",
    "bash": "ask",
    "edit": "ask",
    "write": "ask",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "lsp": "allow",
    "patch": "ask",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
  },
  "mcp": {
    "playwright": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
      ],
    },
    "MSLearn": {
      "enabled": false,
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp",
    },
  },
}
